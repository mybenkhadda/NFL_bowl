# Copy to `.env` (same folder) and fill in every CHANGE_ME. `.env` is git-ignored.
# Generate secrets in PowerShell, e.g.:
#   [Convert]::ToBase64String((1..42 | ForEach-Object { Get-Random -Maximum 256 }))

# ---- Paths -------------------------------------------------------------------------
# ABSOLUTE host path of the project root, forward slashes (Docker Desktop on Windows). Its
# warehouse/serving folder must contain nfl_lab.duckdb (built by `python -m nflbdb.lab.build`).
# A relative value is resolved against THIS folder; absolute avoids surprises with `-f` / other cwd.
NFL_BDB_PROJECT_ROOT=C:/Users/<you>/Downloads/nfl-big-data-bowl-2027/nfl-big-data-bowl-2027

# ---- Image versions (pinned; see docs/architecture.md → Compatibility) ---------------
SUPERSET_VERSION=5.0.0
POSTGRES_VERSION=16.4-alpine
GRAFANA_VERSION=12.0.2
# Optionally pin the plugin, e.g. frser-sqlite-datasource@<version>
GRAFANA_SQLITE_PLUGIN=frser-sqlite-datasource

# ---- Superset ------------------------------------------------------------------------
SUPERSET_SECRET_KEY=CHANGE_ME_long_random_string
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=CHANGE_ME
SUPERSET_ADMIN_EMAIL=admin@localhost
# 1 worker × 8 threads fits one local user; 2+ workers multiply RSS (exit 137 = OOM kill).
SUPERSET_WORKERS=1
SUPERSET_THREADS=8
SUPERSET_WORKER_MAX_REQUESTS=1000
SUPERSET_MEM_LIMIT=2g
# Seconds a chart result stays cached (in-process cache; cleared on restart).
LAB_DATA_CACHE_SECONDS=3600
# on_change = import bundled dashboards only when their definition changed (default)
# always    = re-import on every start (OVERWRITES edits made in the UI)
# never     = never import automatically
LAB_IMPORT_MODE=on_change

# ---- Superset metadata database (PostgreSQL) -----------------------------------------
POSTGRES_USER=superset
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=superset
# Read-only role Grafana uses to chart Superset query durations.
GRAFANA_READER_PASSWORD=CHANGE_ME

# ---- Streamlit -----------------------------------------------------------------------
STREAMLIT_MEM_LIMIT=1536m
STREAMLIT_DUCKDB_MEMORY=768MB
LAB_MAX_TRAJECTORY_FRAMES=6000

# ---- Grafana (profile: monitoring) ---------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---- Host ports (always bound to 127.0.0.1) ------------------------------------------
SUPERSET_PORT=8088
STREAMLIT_PORT=8501
GRAFANA_PORT=3000
