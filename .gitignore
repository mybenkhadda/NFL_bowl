# Raw Kaggle data (never commit; licensed competition data). Anchored to the repository root: an unanchored
# `data/` would also ignore the PACKAGES src/nflbdb/data and src/nflbowl/data and break `pip install git+…`.
/data/

# nflbowl experiment outputs, staged bundles and exports (live on Drive / local disk, never in git)
/experiments/
/bundles/
/exports/
*.pt

# Generated lakehouse layers and DuckDB catalog (rebuildable from raw data)
warehouse/
*.duckdb
*.duckdb.wal

# Scratch / spill / logs
.tmp/
tmp/
logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/

# Large per-run artifacts (small summary tables in reports/tables ARE committed)
reports/tables/*_rows_sample.*
reports/tables/benchmarks_raw.*

# Google Drive upload credentials (tools/upload_to_drive.py api backend) — never commit
tools/drive_credentials.json
drive_token.json

# Archives of generated outputs (reports/figures.zip is 292 MB, above the GitHub file limit; contents are already in the tree)
*.zip
